# Private site layer (AGENTS.md §"The private layer", ROADMAP §2).
# Same pattern OpsKit runs on environments/ — only the example fixture is tracked.
sites/*
!sites/example/

# Emitted payloads are build output, regenerated by `make build`.
sites/*/build/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Agent / editor local state. The trailing * matters: the settings file is
# written atomically via .tmp.<pid>.<hash> siblings, and one of those will land
# in `git add -A` if it happens to exist at the wrong moment.
.claude/settings.local.json*
.opencode/local/

# Secrets and credentials — never tracked, guard is the backstop not the policy
*.pem
*.key
.env
.env.*
!.env.example

# OS noise
.DS_Store

# Session working log — memory funnel, never published
session.log

# Agent worktrees — each is a full checkout carrying its own local state
# (settings, venv links, scratch). Nothing under here is ever repo content.
.claude/worktrees/

# Session working notes (was review_01.md) — memory funnel, never published
NOTES.md

# Bootstrap-era session narrative — private working file, superseded publicly
# by docs/ROADMAP.md + docs/ISSUES.md
RESUME.md
