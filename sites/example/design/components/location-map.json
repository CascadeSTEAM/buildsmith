{
  "name": "Location Map",
  "root": {
    "element": "iframe",
    "attributes": {
      "src": "https://www.openstreetmap.org/export/embed.html?bbox=-0.006%2C-0.006%2C0.006%2C0.006&layer=mapnik&marker=0.0%2C0.0",
      "loading": "lazy",
      "title": "Map: 1 Example Way, Nowhere"
    },
    "baseStyles": {
      "width": "@map-width",
      "height": "@map-height",
      "borderRadius": "@map-radius",
      "borderWidth": "1px",
      "borderStyle": "solid",
      "borderColor": "@map-border",
      "overflow": "hidden"
    }
  }
}
